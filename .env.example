# ==============================================================================
# Prama Environment Configuration
# ==============================================================================

# 1. Google Gemini API Key (Primary Online LLM Provider)
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_RPM_LIMIT=15
GEMINI_MAX_RETRIES=3

# 2. Provider Routing
# Options: "auto" (Gemini -> Ollama -> Null fallback), "gemini", "ollama", "null"
LLM_PROVIDER=auto

# 3. Local SLM (Ollama Fallback)
SLM_BASE_URL=http://localhost:11434
SLM_MODEL=qwen2.5:3b
SLM_ENABLED=true
SLM_TIMEOUT_SECONDS=30
SLM_TEMPERATURE=0.0

# 4. Security & Demo Clock
SECRET_KEY=aicte_fdr_sentinel_super_secret_jwt_key_2026_sih
DEMO_MODE=true
